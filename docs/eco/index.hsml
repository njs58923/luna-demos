    <!-- La vuelta: la misma puerta que en todas las salas. A la izquierda, a
         media vuelta: adelante estan las runas y no tiene que competir con ellas. -->
    <group x="-3.6" y="0" z="-0.4" ry="1.46">
      <include id="al_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world" props='{"destino":"https://njs58923.github.io/luna-demos/index.hsml","id":"al_atrio","titulo":"Al atrio","sub":"la arcada","roca":"#383F4C","color":"#1E2A40"}'/>
    </group>

    <group id="runas">
      <group x="-1.5" y="1.45" z="-1.61" ry="0.75">
        <!-- La placa. El id lo usa el script para encenderla. -->
        <box id="eco_1" sx="0.42" sy="0.42" sz="0.05" color="#2E5E8C"
             border-radius="0.06" touchable="false"/>
        <!-- Y el blanco, delante y transparente: desde que el color acepta
             alfa, una zona de impacto no tiene que disfrazarse del color de lo
             que tapa. Sigue recibiendo toque y hover sin dibujar nada. -->
        <plane id="eco_1_toque" z="0.04" sx="0.46" sy="0.46"
               color="transparent" material-alpha="blend" touchable="true"/>
      </group>

      <group x="-0.957" y="1.45" z="-1.981" ry="0.45">
        <!-- La placa. El id lo usa el script para encenderla. -->
        <box id="eco_2" sx="0.42" sy="0.42" sz="0.05" color="#2E7E6B"
             border-radius="0.06" touchable="false"/>
        <!-- Y el blanco, delante y transparente: desde que el color acepta
             alfa, una zona de impacto no tiene que disfrazarse del color de lo
             que tapa. Sigue recibiendo toque y hover sin dibujar nada. -->
        <plane id="eco_2_toque" z="0.04" sx="0.46" sy="0.46"
               color="transparent" material-alpha="blend" touchable="true"/>
      </group>

      <group x="-0.329" y="1.45" z="-2.175" ry="0.15">
        <!-- La placa. El id lo usa el script para encenderla. -->
        <box id="eco_3" sx="0.42" sy="0.42" sz="0.05" color="#5E7E2E"
             border-radius="0.06" touchable="false"/>
        <!-- Y el blanco, delante y transparente: desde que el color acepta
             alfa, una zona de impacto no tiene que disfrazarse del color de lo
             que tapa. Sigue recibiendo toque y hover sin dibujar nada. -->
        <plane id="eco_3_toque" z="0.04" sx="0.46" sy="0.46"
               color="transparent" material-alpha="blend" touchable="true"/>
      </group>

      <group x="0.329" y="1.45" z="-2.175" ry="-0.15">
        <!-- La placa. El id lo usa el script para encenderla. -->
        <box id="eco_4" sx="0.42" sy="0.42" sz="0.05" color="#8C6A2E"
             border-radius="0.06" touchable="false"/>
        <!-- Y el blanco, delante y transparente: desde que el color acepta
             alfa, una zona de impacto no tiene que disfrazarse del color de lo
             que tapa. Sigue recibiendo toque y hover sin dibujar nada. -->
        <plane id="eco_4_toque" z="0.04" sx="0.46" sy="0.46"
               color="transparent" material-alpha="blend" touchable="true"/>
      </group>

      <group x="0.957" y="1.45" z="-1.981" ry="-0.45">
        <!-- La placa. El id lo usa el script para encenderla. -->
        <box id="eco_5" sx="0.42" sy="0.42" sz="0.05" color="#8C3E4E"
             border-radius="0.06" touchable="false"/>
        <!-- Y el blanco, delante y transparente: desde que el color acepta
             alfa, una zona de impacto no tiene que disfrazarse del color de lo
             que tapa. Sigue recibiendo toque y hover sin dibujar nada. -->
        <plane id="eco_5_toque" z="0.04" sx="0.46" sy="0.46"
               color="transparent" material-alpha="blend" touchable="true"/>
      </group>

      <group x="1.5" y="1.45" z="-1.61" ry="-0.75">
        <!-- La placa. El id lo usa el script para encenderla. -->
        <box id="eco_6" sx="0.42" sy="0.42" sz="0.05" color="#6A3E8C"
             border-radius="0.06" touchable="false"/>
        <!-- Y el blanco, delante y transparente: desde que el color acepta
             alfa, una zona de impacto no tiene que disfrazarse del color de lo
             que tapa. Sigue recibiendo toque y hover sin dibujar nada. -->
        <plane id="eco_6_toque" z="0.04" sx="0.46" sy="0.46"
               color="transparent" material-alpha="blend" touchable="true"/>
      </group>
    </group>

    <!-- Los glifos: UN nodo para los seis. Se tesela una vez con PathGeometry y
         lo unico que cambia al encenderse una runa son sus colores de vertice.
         material-unlit es la diferencia entre un simbolo y una pared pintada:
         sin eso el material estandar lo ilumina y el color depende de donde
         este parado el visitante. -->
    <model id="glifos" material-unlit="true"/>

    <!-- Los puntos de progreso: uno por nota de la ronda. Arrancan invisibles
         porque hasta que empieza la partida no hay ninguna nota que contar. -->
    <model id="pasos" material-unlit="true" visible="false"/>

    <!-- El altar: el único mueble. Marca dónde pararse y da algo que tocar para
         empezar. -->
    <group id="altar" z="-0.6">
      <cylinder y="0.35" sx="0.62" sy="0.7" sz="0.62" color="#1E2733" touchable="false"/>
      <cylinder y="0.72" sx="0.78" sy="0.06" sz="0.78" color="#2A3444" touchable="false"/>
      <plane id="altar_toque" y="0.76" rx="1.5707963" sx="0.7" sy="0.7"
             color="transparent" material-alpha="blend" touchable="true"/>
    </group>

    <text id="cartel" y="2.35" z="-2.3" value="La sala de los ecos" size="0.14" color="#EDF2FA"/>
    <text id="estado" y="2.12" z="-2.3" value="tocá el altar para empezar" size="0.07" color="#93A2B8"/>

