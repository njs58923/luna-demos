<!-- generado por server_expo desde public/models/ - no editar a mano -->
<hsml>
  <head>
    <name>Expo Lowpoly</name>
    <meta type="position" x="0" y="0" z="0"/>
    <meta type="rotation" x="0" y="0" z="0"/>
    <meta type="scale" x="1" y="1" z="1"/>
  </head>

  <!-- OJO: esto estuvo separado por ESPACIOS y por eso la escena corria sin
       ninguna capacidad, en silencio: parse_resource_tokens hace split(',') a
       secas, asi que "navigate_self fetch_text ..." es UN token que no matchea
       ningun bundle. Van por COMA. -->
  <space resources="navigate_self,navigate_world,fetch_text,desktop_camera_control,vr_locomotion,spawn">
    <!-- A espaldas de la llegada, sobre el ramal: el portal a la calle de los
         objetos, la expo grande. Es uno de sus objetos (objetos/portal.hsml),
         montado acá como se montaría en cualquier mundo. navigate_world lo
         pide el space sólo para delegárselo. -->
    <group z="5.2" ry="3.1415927">
      <include id="a_la_calle" src="https://njs58923.github.io/luna-demos/expo/objetos/portal.hsml" resources="navigate_world"
               props='{"destino":"https://njs58923.github.io/luna-demos/expo/calle.hsml","titulo":"La calle de los objetos","sub":"la expo grande","color":"#E9C46A"}'/>
    </group>
    <!-- Donde aparece el visitante: el medallon del centro, mirando al sendero.
         El islote se genera alrededor del origen y los pedestales dejan libre
         el circulo de r=2.9, asi que aca no hay nada con que chocar. -->
    <spawn id="entrada" default="true" x="0" y="0" z="0" ry="0"/>

