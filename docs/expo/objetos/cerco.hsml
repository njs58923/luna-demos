<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cerco de estacas, de tablas, reja de hierro con puntas o alambrado.
  Tocarlo cambia el tipo.

    <include src="https://njs58923.github.io/luna-demos/expo/objetos/cerco.hsml" resources="read_pose_stream"
             props='{"tipo":"reja","largo":8}'/>

  Props: largo, alto, tipo (estacas|tablas|reja|alambrado), color, puntas.
  Eventos: cambio {tipo}.
-->
<hsml>
  <head><name>Cerco</name></head>
  <space resources="read_pose_stream">
    <group id="obra"/>
    <box id="toque" color="transparent" material-alpha="blend"/>
    <script src="./cerco.js"/>
  </space>
</hsml>
