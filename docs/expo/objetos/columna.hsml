<?xml version="1.0" encoding="UTF-8"?>
<!--
  Columna clásica (basa, fuste estriado, capitel), salomónica, cuadrada o
  moderna. Tocarla cambia el orden.

    <include src="https://njs58923.github.io/luna-demos/expo/objetos/columna.hsml" resources="read_pose_stream"
             props='{"tipo":"salomonica","alto":3}'/>

  Props: alto, diametro, tipo (clasica|salomonica|cuadrada|moderna), color.
  Eventos: cambio {tipo}.
-->
<hsml>
  <head><name>Columna</name></head>
  <space resources="read_pose_stream">
    <group id="obra"/>
    <box id="toque" color="transparent" material-alpha="blend"/>
    <script src="./columna.js"/>
  </space>
</hsml>
