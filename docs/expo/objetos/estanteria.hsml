<?xml version="1.0" encoding="UTF-8"?>
<!--
  Estantería con libros. Los libros de lomo dorado se pueden leer: tocarlo lo
  saca, vuela adelante y se abre. Tocar la página derecha pasa de hoja, la
  izquierda vuelve, y la cinta de arriba lo devuelve al estante.

  De piso: apoya en y=0, el frente mira a +Z. Mide 1.0 × 1.8 × 0.32 m (un
  libro abierto flota 0.5 m por delante).

    <include src="https://njs58923.github.io/luna-demos/expo/objetos/estanteria.hsml" events="libro"
             props='{"libros":[{"titulo":"Recetas","texto":"Pan: harina, agua, sal..."}]}'/>

  Props: libros (lista de {titulo, texto}; hasta 8 se pueden leer), madera.
  Eventos: libro {titulo, pagina}.
  Mensajes: cerrar.
-->
<hsml>
  <head><name>Estantería con libros</name></head>
  <space resources="read_pose_stream">
    <group id="mueble"/>
    <group id="libros"/>
    <group id="lector" y="1.25" z="0.55" visible="false">
      <box id="tapa_izq" x="-0.16" z="-0.012" sx="0.32" sy="0.42" sz="0.01" color="#6B1E2E"/>
      <box id="tapa_der" x="0.16" z="-0.012" sx="0.32" sy="0.42" sz="0.01" color="#6B1E2E"/>
      <box id="pagina_izq" x="-0.152" sx="0.3" sy="0.4" sz="0.008" color="#FBF6E9"/>
      <box id="pagina_der" x="0.152" sx="0.3" sy="0.4" sz="0.008" color="#FBF6E9"/>
      <group id="renglones" z="0.005"/>
      <text id="folio_izq" x="-0.152" y="-0.18" z="0.005" value="" size="0.014" color="#8A7A5A"/>
      <text id="folio_der" x="0.152" y="-0.18" z="0.005" value="" size="0.014" color="#8A7A5A"/>
      <box id="cinta" y="0.23" z="0.004" sx="0.03" sy="0.07" sz="0.003" color="#C8102E"/>
    </group>
    <script src="./estanteria.js"/>
  </space>
</hsml>
