<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gato. Sentado en su almohadón, sigue con la cabeza al que pasa, parpadea y
  mueve la cola. Acariciarlo (tocarlo, o en VR pasarle la mano por el lomo)
  lo hace ronronear; muchos toques seguidos, maúlla. Si nadie le da bola un
  rato, se duerme; acercarse o tocarlo lo despierta.

  De piso: apoya en y=0. Mide 0.45 × 0.45 × 0.45 m.

    <include src="https://njs58923.github.io/luna-demos/expo/objetos/gato.hsml"
             resources="audio,read_pose_stream,read_camera_pose"
             events="ronroneo,miau" props='{"pelaje":"#F4A261"}'/>

  Props: pelaje, pecho, ojos (colores), cojin (color del almohadón),
  sueño (segundos sin atención hasta dormirse).
  Eventos: ronroneo {}, miau {}, duerme {}, despierta {}.
  Mensajes: maullar, dormir, despertar.
-->
<hsml>
  <head><name>Gato</name></head>
  <space resources="audio,read_pose_stream,read_camera_pose">
    <cylinder id="cojin" y="0.035" sx="0.44" sy="0.07" sz="0.44" color="#8E7DBE" border-radius="0.03"/>
    <cylinder y="0.071" sx="0.36" sy="0.004" sz="0.36" color="#A898D0"/>
    <group id="gato" y="0.07">
      <group id="torso_g">
        <sphere id="torso" y="0.12" z="-0.02" sx="0.2" sy="0.24" sz="0.26" color="#F4A261"/>
        <sphere id="pecho" y="0.14" z="0.075" sx="0.13" sy="0.15" sz="0.08" color="#FFF1E0"/>
        <sphere class="pelaje" x="-0.075" y="0.06" z="-0.05" sx="0.1" sy="0.11" sz="0.17" color="#F4A261"/>
        <sphere class="pelaje" x="0.075" y="0.06" z="-0.05" sx="0.1" sy="0.11" sz="0.17" color="#F4A261"/>
        <cylinder class="pelaje" x="-0.04" y="0.06" z="0.09" sx="0.04" sy="0.12" sz="0.04" color="#F4A261"/>
        <cylinder class="pelaje" x="0.04" y="0.06" z="0.09" sx="0.04" sy="0.12" sz="0.04" color="#F4A261"/>
        <sphere class="pecho" x="-0.04" y="0.01" z="0.11" sx="0.05" sy="0.03" sz="0.06" color="#FFF1E0"/>
        <sphere class="pecho" x="0.04" y="0.01" z="0.11" sx="0.05" sy="0.03" sz="0.06" color="#FFF1E0"/>
      </group>
      <group id="cabeza" y="0.29" z="0.05">
        <sphere class="pelaje" sx="0.15" sy="0.13" sz="0.13" color="#F4A261"/>
        <sphere class="pecho" y="-0.025" z="0.05" sx="0.075" sy="0.05" sz="0.05" color="#FFF1E0"/>
        <sphere y="-0.008" z="0.074" sx="0.016" sy="0.011" sz="0.01" color="#E88A9A"/>
        <group id="ojos" y="0.015" z="0.055">
          <group x="-0.034">
            <sphere class="ojo" sx="0.03" sy="0.03" sz="0.016" color="#9ACD32"/>
            <box z="0.008" sx="0.006" sy="0.022" sz="0.002" color="#111111"/>
          </group>
          <group x="0.034">
            <sphere class="ojo" sx="0.03" sy="0.03" sz="0.016" color="#9ACD32"/>
            <box z="0.008" sx="0.006" sy="0.022" sz="0.002" color="#111111"/>
          </group>
        </group>
        <group x="-0.045" y="0.055" z="-0.005" rz="0.25">
          <box class="pelaje" rz="0.785" sx="0.045" sy="0.045" sz="0.012" color="#F4A261"/>
          <box rz="0.785" z="0.004" y="-0.004" sx="0.028" sy="0.028" sz="0.006" color="#E88A9A"/>
        </group>
        <group x="0.045" y="0.055" z="-0.005" rz="-0.25">
          <box class="pelaje" rz="0.785" sx="0.045" sy="0.045" sz="0.012" color="#F4A261"/>
          <box rz="0.785" z="0.004" y="-0.004" sx="0.028" sy="0.028" sz="0.006" color="#E88A9A"/>
        </group>
        <cylinder x="-0.06" y="-0.02" z="0.06" rz="1.45" sx="0.002" sy="0.08" sz="0.002" color="#FFFFFF"/>
        <cylinder x="-0.06" y="-0.03" z="0.06" rz="1.7" sx="0.002" sy="0.08" sz="0.002" color="#FFFFFF"/>
        <cylinder x="0.06" y="-0.02" z="0.06" rz="-1.45" sx="0.002" sy="0.08" sz="0.002" color="#FFFFFF"/>
        <cylinder x="0.06" y="-0.03" z="0.06" rz="-1.7" sx="0.002" sy="0.08" sz="0.002" color="#FFFFFF"/>
      </group>
      <group id="cola"/>
      <text id="zzz" y="0.42" x="0.1" value="" size="0.05" color="#FFFFFF"/>
    </group>
    <box id="toque" y="0.25" sx="0.3" sy="0.4" sz="0.34" color="transparent" material-alpha="blend"/>
    <posezone id="zona" y="0.4" sx="1" sy="0.8" sz="1" visible="false"/>
    <script src="./gato.js"/>
  </space>
</hsml>
