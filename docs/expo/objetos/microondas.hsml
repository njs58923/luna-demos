<?xml version="1.0" encoding="UTF-8"?>
<!--
  Microondas. La puerta se abre tocándola; +30 suma medio minuto y el botón
  verde lo arranca (con la puerta cerrada). Adentro gira el plato con una
  taza, se prende la luz, y al terminar pita tres veces.

  De mesa: apoya en y=0, la puerta mira a +Z. Mide 0.5 × 0.3 × 0.38 m.

    <include src="https://njs58923.github.io/luna-demos/expo/objetos/microondas.hsml"
             resources="audio" events="fin" props='{"color":"#DEE2E6"}'/>

  Props: color.
  Eventos: fin {segundos}.
  Mensajes: sumar {segundos}, arrancar, parar.
-->
<hsml>
  <head><name>Microondas</name></head>
  <space resources="audio,read_pose_stream">
    <box id="caja" y="0.15" sx="0.5" sy="0.3" sz="0.38" color="#DEE2E6" border-radius="0.02"/>
    <box y="0.15" x="-0.06" z="0.186" sx="0.34" sy="0.24" sz="0.01" color="#101418"/>
    <box id="interior" y="0.15" x="-0.06" z="0.05" sx="0.32" sy="0.22" sz="0.26" color="#2A2A2A"/>
    <group id="plato" x="-0.06" y="0.045" z="0.05">
      <cylinder sx="0.24" sy="0.008" sz="0.24" color="#DDE7EE"/>
      <group id="taza" x="0.05">
        <cylinder y="0.04" sx="0.07" sy="0.07" sz="0.07" color="#F4A261"/>
        <cylinder y="0.074" sx="0.06" sy="0.002" sz="0.06" color="#5A3A20"/>
      </group>
    </group>
    <!-- La puerta: bisagra a la izquierda -->
    <group id="bisagra" x="-0.25" y="0.15" z="0.195">
      <box id="puerta" x="0.19" sx="0.38" sy="0.28" sz="0.02" color="#CED4DA"/>
      <box id="vidrio" x="0.19" z="0.011" sx="0.3" sy="0.2" sz="0.002" color="#1E2A30"/>
      <box x="0.36" z="0.02" sx="0.02" sy="0.18" sz="0.03" color="#ADB5BD"/>
    </group>
    <box y="0.26" x="0.18" z="0.19" sx="0.12" sy="0.04" sz="0.004" color="#101418"/>
    <text id="visor" y="0.26" x="0.18" z="0.193" value="0:00" size="0.022" color="#30D158"/>
    <box id="mas30" y="0.18" x="0.18" z="0.19" sx="0.1" sy="0.04" sz="0.01" color="#495057"/>
    <text y="0.18" x="0.18" z="0.196" value="+30" size="0.018" color="#FFFFFF"/>
    <box id="arrancar" y="0.12" x="0.18" z="0.19" sx="0.1" sy="0.04" sz="0.01" color="#2B8A3E"/>
    <text y="0.12" x="0.18" z="0.196" value="INICIO" size="0.014" color="#FFFFFF"/>
    <box id="parar" y="0.06" x="0.18" z="0.19" sx="0.1" sy="0.04" sz="0.01" color="#C92A2A"/>
    <text y="0.06" x="0.18" z="0.196" value="PARAR" size="0.014" color="#FFFFFF"/>
    <script src="./microondas.js"/>
  </space>
</hsml>
