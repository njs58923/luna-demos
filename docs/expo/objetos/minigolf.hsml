<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mini golf. Una cancha con un hoyo, su banderita y una barrera que va y
  viene delante del hoyo. Tocar el césped tira la pelota hacia ese punto, con
  la fuerza justa para llegar ahí (más o menos). En VR se agarra el palo con
  el grip y se le pega a la pelota de verdad. Cuenta los golpes y se acuerda
  del mejor (por `clave`).

  De piso: apoya en y=0. Mide 1.7 × 0.3 × 0.6 m (con la bandera, 0.5 de alto).

    <include src="https://njs58923.github.io/luna-demos/expo/objetos/minigolf.hsml"
             resources="audio,read_pose_stream" events="hoyo"/>

  Props: clave, barrera (true/false).
  Eventos: golpe {golpes}, hoyo {golpes, record}.
  Mensajes: reiniciar.
-->
<hsml>
  <head><name>Mini golf</name></head>
  <space resources="audio,read_pose_stream">
    <box id="cesped" y="0.01" sx="1.6" sy="0.02" sz="0.5" color="#3A8D3F"/>
    <box y="0.03" z="0.26" sx="1.66" sy="0.06" sz="0.03" color="#8B5A2B"/>
    <box y="0.03" z="-0.26" sx="1.66" sy="0.06" sz="0.03" color="#8B5A2B"/>
    <box x="0.815" y="0.03" sx="0.03" sy="0.06" sz="0.5" color="#8B5A2B"/>
    <box x="-0.815" y="0.03" sx="0.03" sy="0.06" sz="0.5" color="#8B5A2B"/>
    <box x="-0.6" y="0.0205" sx="0.06" sy="0.001" sz="0.06" color="#2D6A31"/>
    <cylinder id="hoyo" x="0.55" y="0.0205" sx="0.06" sy="0.002" sz="0.06" color="#111111"/>
    <group x="0.55">
      <cylinder y="0.26" sx="0.006" sy="0.5" sz="0.006" color="#F1FAEE"/>
      <box id="bandera" x="0.05" y="0.46" sx="0.1" sy="0.06" sz="0.002" color="#D62828"/>
    </group>
    <box x="0.2" y="0.04" z="-0.18" sx="0.04" sy="0.04" sz="0.14" color="#8B5A2B"/>
    <box x="0.2" y="0.04" z="0.18" sx="0.04" sy="0.04" sz="0.14" color="#8B5A2B"/>
    <box id="barrera" x="0.2" y="0.04" sx="0.04" sy="0.04" sz="0.12" color="#FFD166"/>
    <sphere id="pelota" x="-0.6" y="0.041" sx="0.042" sy="0.042" sz="0.042" color="#FFFFFF"/>
    <group id="palo" x="-0.75" z="0.2">
      <cylinder y="0.45" sx="0.012" sy="0.8" sz="0.012" color="#B0B0B0"/>
      <cylinder y="0.8" sx="0.022" sy="0.14" sz="0.022" color="#1C1C1C"/>
      <box y="0.035" x="0.03" sx="0.1" sy="0.03" sz="0.03" color="#6C757D"/>
    </group>
    <text id="marcador" x="-0.5" y="0.12" z="-0.27" value="" size="0.04" color="#FFFFFF"/>
    <posezone id="zona" y="0.6" sx="2" sy="1.4" sz="1.2" visible="false"/>
    <script src="./minigolf.js"/>
  </space>
</hsml>
