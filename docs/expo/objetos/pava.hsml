<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pava y mate. La perilla prende el fuego y el termómetro de la pava sube.
  Tocar el mate lo ceba con el agua como esté: entre 70 y 85 °C sale bien;
  más caliente, se quema la yerba; fría, queda lavado enseguida. Si se deja
  hervir, la pava silba. Después de unas cuantas cebadas el mate se lava;
  tocar la yerbera lo renueva.

  De mesa: apoya en y=0. Mide 0.5 × 0.3 × 0.3 m.

    <include src="https://njs58923.github.io/luna-demos/expo/objetos/pava.hsml"
             resources="audio" events="cebado,hierve"/>

  Eventos: cebado {temperatura, estado: "bien" | "quemado" | "frio" | "lavado"},
  hierve {}, fuego {prendido}.
  Mensajes: fuego {prendido}, yerba.
-->
<hsml>
  <head><name>Pava y mate</name></head>
  <space resources="audio,read_pose_stream">
    <box x="-0.08" y="0.02" sx="0.26" sy="0.04" sz="0.26" color="#D9D9D9" border-radius="0.01"/>
    <cylinder x="-0.08" y="0.042" sx="0.16" sy="0.004" sz="0.16" color="#2B2B2B"/>
    <group id="fuego" x="-0.08" y="0.045"/>
    <cylinder id="perilla" x="0.02" y="0.03" z="0.132" rx="1.5708" sx="0.028" sy="0.012" sz="0.028" color="#1C1C1C"/>
    <box x="0.02" y="0.036" z="0.139" sx="0.004" sy="0.013" sz="0.002" color="#FFFFFF"/>
    <group id="pava" x="-0.08" y="0.046">
      <cylinder y="0.055" sx="0.17" sy="0.11" sz="0.17" color="#B8BEC5"/>
      <cylinder y="0.115" sx="0.12" sy="0.012" sz="0.12" color="#A5ABB2"/>
      <cylinder y="0.125" sx="0.03" sy="0.012" sz="0.03" color="#1C1C1C"/>
      <cylinder x="0.1" y="0.08" rz="-0.9" sx="0.022" sy="0.09" sz="0.022" color="#B8BEC5"/>
      <box y="0.15" sx="0.02" sy="0.012" sz="0.14" color="#1C1C1C"/>
      <box y="0.13" z="0.065" sx="0.014" sy="0.04" sz="0.012" color="#1C1C1C"/>
      <box y="0.13" z="-0.065" sx="0.014" sy="0.04" sz="0.012" color="#1C1C1C"/>
      <cylinder y="0.06" z="0.086" rx="1.5708" sx="0.05" sy="0.004" sz="0.05" color="#FFFFFF"/>
      <group id="aguja" y="0.06" z="0.089"><box y="0.008" sx="0.002" sy="0.017" sz="0.001" color="#D62828"/></group>
      <text id="grados" y="0.045" z="0.089" value="20°" size="0.008" color="#1C1C1C"/>
      <box id="toque_pava" y="0.07" sx="0.2" sy="0.16" sz="0.2" color="transparent" material-alpha="blend"/>
    </group>
    <group id="vapor"/>
    <group id="mate" x="0.15" z="0.04">
      <cylinder y="0.025" sx="0.06" sy="0.05" sz="0.06" color="#6B4226"/>
      <cylinder y="0.052" sx="0.064" sy="0.006" sz="0.064" color="#C0C0C0"/>
      <cylinder id="yerba" y="0.053" sx="0.052" sy="0.004" sz="0.052" color="#6B8E23"/>
      <cylinder id="agua" y="0.054" sx="0.04" sy="0.002" sz="0.04" color="#8DB600" visible="false"/>
      <cylinder x="0.012" y="0.08" rz="-0.25" sx="0.006" sy="0.09" sz="0.006" color="#C0C0C0"/>
      <box id="toque_mate" y="0.04" sx="0.08" sy="0.1" sz="0.08" color="transparent" material-alpha="blend"/>
    </group>
    <group id="yerbera" x="0.17" z="-0.08">
      <box y="0.04" sx="0.05" sy="0.08" sz="0.05" color="#E9C46A" border-radius="0.006"/>
      <text y="0.05" z="0.026" value="YERBA" size="0.009" color="#264653"/>
      <box id="toque_yerbera" y="0.04" sx="0.07" sy="0.1" sz="0.07" color="transparent" material-alpha="blend"/>
    </group>
    <text id="cartel" x="0.15" y="0.16" value="" size="0.016" color="#FFFFFF"/>
    <script src="./pava.js"/>
  </space>
</hsml>
