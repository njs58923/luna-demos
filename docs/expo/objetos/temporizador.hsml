<?xml version="1.0" encoding="UTF-8"?>
<!--
  Temporizador de cocina. Se le cargan minutos, se larga, y el dial gira de
  vuelta hasta cero; ahí suena una campanita.

  De mesa: apoya en y=0. Mide 0.16 × 0.14 × 0.16 m.

    <include src="https://njs58923.github.io/luna-demos/expo/objetos/temporizador.hsml"
             resources="audio" events="fin" props='{"minutos":3,"color":"#E63946"}'/>

  Botones del frente: +1 y +5 minutos, ▶ larga o pausa, ■ vuelve a cero.
  Props: minutos (los que trae cargados), color.
  Eventos: fin {segundos} al llegar a cero.
  Mensajes: cargar {minutos}, largar, pausar.
-->
<hsml>
  <head><name>Temporizador de cocina</name></head>
  <space resources="audio,read_pose_stream">
    <cylinder id="cuerpo" y="0.045" sx="0.15" sy="0.09" sz="0.15" color="#E63946"/>
    <cylinder id="cuerpo_base" y="0.004" sx="0.155" sy="0.008" sz="0.155" color="#B02A35"/>
    <!-- El dial gira; la flecha no -->
    <group id="dial" y="0.095">
      <cylinder id="dial_disco" sx="0.14" sy="0.012" sz="0.14" color="#F4F1EA"/>
    </group>
    <box y="0.106" z="0.066" sx="0.008" sy="0.012" sz="0.02" color="#1C1C1C"/>
    <cylinder id="perilla" manos="false" y="0.115" sx="0.05" sy="0.025" sz="0.05" color="#F4F1EA"/>
    <box y="0.13" sx="0.05" sy="0.012" sz="0.012" color="#E0DCD2"/>
    <!-- La lectura y los botones, en el frente -->
    <group z="0.077" y="0.048">
      <box z="-0.002" sx="0.07" sy="0.024" sz="0.004" color="#101418" border-radius="0.004"/>
      <text id="lectura" z="0.001" value="00:00" size="0.016" color="#FFD60A"/>
    </group>
    <box id="b_mas1" x="-0.05" y="0.02" z="0.066" ry="0.6" sx="0.024" sy="0.018" sz="0.01" color="#F4F1EA"/>
    <box id="b_mas5" x="-0.02" y="0.02" z="0.074" ry="0.25" sx="0.024" sy="0.018" sz="0.01" color="#F4F1EA"/>
    <box id="b_largar" x="0.02" y="0.02" z="0.074" ry="-0.25" sx="0.024" sy="0.018" sz="0.01" color="#30D158"/>
    <box id="b_cero" x="0.05" y="0.02" z="0.066" ry="-0.6" sx="0.024" sy="0.018" sz="0.01" color="#1C1C1C"/>
    <text x="-0.05" y="0.02" z="0.072" ry="0.6" value="+1" size="0.01" color="#1C1C1C"/>
    <text x="-0.02" y="0.02" z="0.08" ry="0.25" value="+5" size="0.01" color="#1C1C1C"/>
    <text id="largar_txt" x="0.02" y="0.02" z="0.08" ry="-0.25" value="GO" size="0.009" color="#FFFFFF"/>
    <text x="0.05" y="0.02" z="0.072" ry="-0.6" value="0" size="0.01" color="#FFFFFF"/>
    <script src="./temporizador.js"/>
  </space>
</hsml>
