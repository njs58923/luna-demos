    <!-- El pedestal donde arranca el objeto; se queda aunque el objeto se vaya. -->
    <cylinder x="0" y="0.37" z="-0.75" sx="0.5" sy="0.7" sz="0.5" color="#1C1C26" touchable="false"/>
    <cylinder x="0" y="0.725" z="-0.75" sx="0.54" sy="0.01" sz="0.54" color="#5A5A70" touchable="false"/>

    <group x="1.9" z="-1.7" ry="-0.841">
      <cylinder y="0.65" sx="0.07" sy="1.3" sz="0.07" color="#5A3E2A" touchable="false"/>
      <group y="1.3" rx="-0.22">
        <box sx="1.5" sy="0.86" sz="0.04" color="#1C1C26" border-radius="0.04" touchable="false"/>
        <text y="0.31" z="0.03" value="EL MANIPULADOR" size="0.08" color="#FFFFFF"/>
        <text y="0.197" z="0.03" value="grip en el cuerpo: mover y girar" size="0.045" color="#40E0D0"/>
        <text y="0.102" z="0.03" value="grip en una esquina: escalar" size="0.045" color="#FF9F0A"/>
        <text y="0.007" z="0.03" value="grip en una arista: girar en X / Y / Z" size="0.045" color="#30D158"/>
        <text y="-0.088" z="0.03" value="dos manos: mover, girar y escalar" size="0.045" color="#BF5AF2"/>
        <text y="-0.183" z="0.03" value="gatillo mientras tanto: encaje" size="0.045" color="#FFD60A"/>
        <text id="estado" y="-0.273" z="0.03" value="la pose se guarda al soltar" size="0.036" color="#C8CCD8"/>

      </group>
    </group>

    <group x="-2.7" y="0" z="-2.3" ry="0.865">
      <include id="al_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world" props='{"destino":"https://njs58923.github.io/luna-demos/manos/index.hsml","id":"al_atrio","titulo":"Al atrio","sub":"el taller de las manos","roca":"#5A3E2A","color":"#2A2A38"}'/>
    </group>

    <!-- Los dos componentes: el manipulador, y adentro, la muestra. Va SIN
         transformar: es dueño de la pose y trabaja en coordenadas de mundo. -->
    <include id="pieza" src="https://njs58923.github.io/luna-demos/manos/manipulador.hsml" resources="read_pose_stream" events="pose"
             props='{"src":"https://njs58923.github.io/luna-demos/manos/muestra.hsml","clave":"robot","caja":{"sx":0.42,"sy":0.72,"sz":0.32,"cy":0.35},"pose":{"x":0,"y":1.08,"z":-0.75,"ry":0.35,"s":1}}'/>

    <script src="https://njs58923.github.io/luna-demos/manos/sala_manipulador.js"/>
  </space>
</hsml>
