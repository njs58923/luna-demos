    <!-- Donde se escuchan los mandos: todo el campo. Con uno chico, al
         alejarse caminando la mano salía, dejaba de mandar poses y el arma
         volvía sola a la mesa. -->
    <posezone id="zona" x="0" y="5" z="-10" sx="160" sy="20" sz="160" visible="false"/>

    <!-- Las armas, la mesa, las botellas, las latas y las placas los arman
         los módulos de tiro/: la geometría y los blancos salen de la misma tabla. -->
    <group id="escenario" data-base="https://njs58923.github.io/luna-demos/manos"/>

    <group x="-1.9" z="-1.3" ry="0.841">
      <cylinder y="0.65" sx="0.07" sy="1.3" sz="0.07" color="#5A3E2A" touchable="false"/>
      <group y="1.3" rx="-0.22">
        <box sx="1.2" sy="0.78" sz="0.04" color="#1C1C26" border-radius="0.04" touchable="false"/>
        <text y="0.287" z="0.03" value="PUNTOS" size="0.045" color="#C8CCD8"/>
        <text id="tablero_puntos" y="0.115" z="0.03" value="0" size="0.2" color="#FFD60A"/>
        <text id="tablero_tiros" y="-0.058" z="0.03" value="ronda de 60 s" size="0.045" color="#FFFFFF"/>
        <text id="tablero_record" y="-0.152" z="0.03" value="récord 0" size="0.045" color="#40E0D0"/>
        <text id="tablero_ultimo" y="-0.245" z="0.03" value="" size="0.04" color="#C8CCD8"/>
        <box id="reiniciar" y="-0.52" z="0.01" sx="0.5" sy="0.12" sz="0.03" color="#2A2A38" border-radius="0.03" touchable="true"/>
        <text y="-0.52" z="0.035" value="RONDA NUEVA" size="0.042" color="#FFFFFF"/>
      </group>
    </group>

    <group x="1.9" z="-1.3" ry="-0.841">
      <cylinder y="0.65" sx="0.07" sy="1.3" sz="0.07" color="#5A3E2A" touchable="false"/>
      <group y="1.3" rx="-0.22">
        <box sx="1.3" sy="0.9" sz="0.04" color="#1C1C26" border-radius="0.04" touchable="false"/>
        <text y="0.33" z="0.03" value="EL TIRO" size="0.08" color="#FFFFFF"/>
        <text y="0.22" z="0.03" value="grip cerca de un arma: tomarla" size="0.04" color="#40E0D0"/>
        <text y="0.13" z="0.03" value="gatillo: tirar · MP5, MAC-10, AK-47 y M4: ráfaga" size="0.04" color="#FF9F0A"/>
        <text y="0.04" z="0.03" value="MP5 y rifles: la otra mano en el guardamanos" size="0.04" color="#40E0D0"/>
        <text y="-0.05" z="0.03" value="recargar: A (o X) suelta el cargador;" size="0.04" color="#30D158"/>
        <text y="-0.14" z="0.03" value="con la otra mano meté uno de la mesa" size="0.04" color="#30D158"/>
        <text y="-0.23" z="0.03" value="y tirá de la corredera, manija o perilla" size="0.04" color="#30D158"/>
        <text y="-0.317" z="0.03" value="botella 5 · lata 3, en el aire 8 · placas 4 · 6 · 10" size="0.034" color="#C8CCD8"/>

      </group>
    </group>

    <group x="-2.4" y="0" z="2.2" ry="2.214">
      <include id="al_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world" props='{"destino":"https://njs58923.github.io/luna-demos/manos/index.hsml","id":"al_atrio","titulo":"Al atrio","sub":"el taller de las manos","roca":"#5A3E2A","color":"#2A2A38"}'/>
    </group>

    <!-- El panel de ajustar arma: el framework de interfaz del motor, montado en
         un grupo que tiro/panel_ajustes.js lleva arriba de la caja activa. El
         framework (luna://internal/ui.js) no se pide acá: lo carga el panel la
         primera vez que se entra al modo ajuste. -->
    <group id="cfg_panel" visible="false">
      <model id="cfg_malla" material-unlit="true" touchable="false"/>
      <group id="cfg_nodos"/>
    </group>

    <script src="https://njs58923.github.io/luna-demos/manos/comun/modulos.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/comun/algebra.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/comun/sintesis.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/comun/interaccion.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/config.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/sonidos.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/escena.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/blancos.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/efectos.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/juego.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/cargadores.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/cajas.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/armas.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/ajustes.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/panel_ajustes.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/disparo.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/manos.js"/>
    <script src="https://njs58923.github.io/luna-demos/manos/tiro/main.js"/>
  </space>
</hsml>
