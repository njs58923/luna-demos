    <!-- La configuración del framework de interfaz va en línea, sin src: un
         script así se evalúa antes que cualquier externo, y ui.js lee UI_CFG al
         cargarse. Al revés, la paleta llega tarde y sin avisar.

         Ojo con nombrar etiquetas dentro de un comentario: el parser del motor
         corta el comentario al ver la apertura y toma lo que sigue como
         marcado. Este comentario tenía la palabra-etiqueta y rompía el script
         de abajo con un SyntaxError que no decía nada. -->
    <script>
      globalThis.UI_CFG = {"base":"https://njs58923.github.io/luna-demos/nave","distancia":1.2,"C":{"texto":"#FFFFFF","tenue":"#8E9CB4","fondo":"#080C12"}};
    </script>
