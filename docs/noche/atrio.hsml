    <!-- El pedestal del centro, con la cuenta. Escalonado, por lo mismo que las
         columnas de la puerta: un cilindro solo no tiene escala. -->
    <group id="centro">
      <cylinder y="0.07" sx="3.6" sy="0.14" sz="3.6" color="#2C3038" touchable="false"/>
      <cylinder y="0.20" sx="3.1" sy="0.14" sz="3.1" color="#4A515C" touchable="false"/>
      <cylinder y="0.62" sx="2.1" sy="0.72" sz="2.1" color="#4A515C" touchable="false"/>
      <!-- El laton va como **moldura**, no como tapa: un disco de 2,2 m de laton
           arriba del pedestal es una chapa de oro que se come el subtitulo. Este
           asoma seis centimetros por debajo del capitel y no tapa nada. -->
      <cylinder y="1.00" sx="2.64" sy="0.035" sz="2.64" color="#C8A24E" touchable="false"/>
      <cylinder y="1.05" sx="2.5" sy="0.10" sz="2.5" color="#5C6472" touchable="false"/>
