      <!-- Portal de vuelta al bestiario. Va en el hueco que deja el arco de
           plintos —que va de 20° a 160°— y no adentro: puesto sobre el arco le
           quedaba un plinto en el vano. Mira al centro, como los plintos, para
           que el texto (que es de una cara sola) se lea desde adentro. -->
      <group id="portal_vuelta" x="-10.5" y="0" z="0" ry="1.571">
        <!-- La misma puerta que las del atrio, y ahora entera de verdad: el vano
             es suyo y navega sola con hiperspace.world.navigate. Esta escena
             solo le delega navigate_world y le dice a donde lleva; el destino
             lo completa el servidor con el ?volver= que mando el atrio. -->
        <include id="puerta_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world"
                 props='{"destino":"https://njs58923.github.io/luna-demos/noche/index.hsml","id":"atrio","titulo":"Al atrio","sub":"tocá para volver","roca":"#4A3A28","color":"#1C2430"}'/>
      </group>
    </group>

