      <box id="reiniciar" x="1.24" y="0.12" rx="-0.5" sx="0.55" sy="0.24" sz="0.05" color="#2A3038" touchable="true" border-radius="0.03"/>
      <text x="1.24" y="0.14" z="0.05" rx="-0.5" value="reiniciar" size="0.05" color="#EAF2FA"/>
    </group>

    <group id="panel" x="0" y="0" z="4.2" ry="3.14159">
      <cylinder x="-1.9" y="0.95" sx="0.1" sy="1.9" sz="0.1" color="#2A3038" touchable="false"/>
      <cylinder x="1.9" y="0.95" sx="0.1" sy="1.9" sz="0.1" color="#2A3038" touchable="false"/>
