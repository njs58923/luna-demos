    <!-- Los mandos, en el borde de la mesa. -->
    <group id="mandos" x="0" y="1.1" z="2.75" ry="3.14159">
      <box id="mas_lento" x="-1.24" y="0.12" rx="-0.5" sx="0.55" sy="0.24" sz="0.05" color="#2A3038" touchable="true" border-radius="0.03"/>
      <text x="-1.24" y="0.14" z="0.05" rx="-0.5" value="- lento" size="0.05" color="#EAF2FA"/>
      <box id="pausa" x="-0.62" y="0.12" rx="-0.5" sx="0.55" sy="0.24" sz="0.05" color="#2A3038" touchable="true" border-radius="0.03"/>
      <text x="-0.62" y="0.14" z="0.05" rx="-0.5" value="pausa" size="0.05" color="#EAF2FA"/>
      <box id="mas_rapido" x="0" y="0.12" rx="-0.5" sx="0.55" sy="0.24" sz="0.05" color="#2A3038" touchable="true" border-radius="0.03"/>
      <text x="0" y="0.14" z="0.05" rx="-0.5" value="+ rapido" size="0.05" color="#EAF2FA"/>
      <box id="paso" x="0.62" y="0.12" rx="-0.5" sx="0.55" sy="0.24" sz="0.05" color="#2A3038" touchable="true" border-radius="0.03"/>
