      <text id="ci_estado" y="2.28" z="0.05" value="Wireworld: cuatro estados, tres reglas" size="0.068" color="#8FA0B4"/>
      <text id="ci_regla" y="2.13" z="0.05" value="conductor -> cabeza si tiene 1 o 2 cabezas vecinas" size="0.05" color="#C8A24E"/>
      <text id="ci_dato" y="2.0" z="0.05" value="" size="0.05" color="#8FA0B4"/>
      <text id="ci_dato2" y="1.88" z="0.05" value="los relojes laten a distinto ritmo porque miden distinto: nadie escribio una frecuencia" size="0.042" color="#8FA0B4"/>
    </group>

    <!-- La leyenda de colores. Sin ella, el tablero es una luz que corre. -->
    <group id="leyenda" x="-4.62" y="1" z="0" ry="1.5707963">
      <box y="0.75" x="-0.4" sx="0.14" sy="0.14" sz="0.03" color="#6A5A2A" touchable="false"/>
