    <!-- El empujador: la única cosa tocable de la escena. Va justo detrás de la
         primera ficha, del color del botón de reinicio, para que se entienda
         que las dos cosas son la misma familia. -->
    <group id="mano" x="2.2" y="0" z="0" ry="0.226">
      <box id="empujar" y="0.42" z="-0.5" sx="0.7" sy="0.84" sz="0.16" color="#8A3B33" touchable="true" border-radius="0.06"/>
      <text y="0.95" z="-0.42" value="empujar" size="0.11" color="#E4ECF5"/>
    </group>

    <!-- Cartel del final del recorrido, arriba de la rampa. -->
    <group x="5.624" y="0" z="7.151" ry="2.291">
      <cylinder y="0.6" sx="0.08" sy="1.2" sz="0.08" color="#2A2F38" touchable="false"/>
      <box y="1.42" sx="1.5" sy="0.44" sz="0.05" color="#0E141C" touchable="false" border-radius="0.04"/>
      <text y="1.5" z="0.04" value="fin" size="0.11" color="#E4ECF5"/>
      <text id="d_fin" y="1.34" z="0.04" value="" size="0.06" color="#8FA2B6"/>
    </group>

    <group id="panel" x="0" y="0" z="15.5" ry="3.14159">
      <cylinder x="-1.3" y="0.7" sx="0.1" sy="1.4" sz="0.1" color="#2A2F38" touchable="false"/>
      <cylinder x="1.3" y="0.7" sx="0.1" sy="1.4" sz="0.1" color="#2A2F38" touchable="false"/>
