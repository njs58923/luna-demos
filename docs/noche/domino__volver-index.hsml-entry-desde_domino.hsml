      <text id="d_titulo" y="1.96" z="0.05" value="El dominó" size="0.15" color="#E4ECF5"/>
      <text id="d_estado" y="1.76" z="0.05" value="240 fichas en pie" size="0.08" color="#8FA2B6"/>
      <text id="d_ayuda" y="1.62" z="0.05" value="tocá el empujador rojo del principio" size="0.065" color="#8FA2B6"/>
      <box id="levantar" y="1.36" z="0.05" sx="1.3" sy="0.24" sz="0.05" color="#8A3B33" touchable="true" border-radius="0.04"/>
      <text y="1.365" z="0.09" value="levantar todo" size="0.075" color="#E4ECF5"/>
    </group>

    <group id="portal_vuelta" x="-6.5" y="0" z="15" ry="2.733">
        <!-- La misma puerta que las del atrio, y ahora entera de verdad: el vano
             es suyo y navega sola con hiperspace.world.navigate. Esta escena
             solo le delega navigate_world y le dice a donde lleva; el destino
             lo completa el servidor con el ?volver= que mando el atrio. -->
        <include id="puerta_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world"
