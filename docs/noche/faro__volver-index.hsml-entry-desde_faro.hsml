        <box x="0" y="1.6" z="-2.72" ry="3.142" sx="0.12" sy="3.0" sz="0.12" color="#2E3038" touchable="false"/>
        <box x="-2.356" y="1.6" z="-1.36" ry="4.189" sx="0.12" sy="3.0" sz="0.12" color="#2E3038" touchable="false"/>
        <box x="-2.356" y="1.6" z="1.36" ry="5.236" sx="0.12" sy="3.0" sz="0.12" color="#2E3038" touchable="false"/>
        <cylinder y="3.3" sx="6.72" sy="0.3" sz="6.72" color="#A8443A" touchable="false"/>
        <cylinder y="4.1" sx="1.4" sy="1.4" sz="1.4" color="#A8443A" touchable="false"/>
        <sphere y="4.9" sx="0.5" sy="0.5" sz="0.5" color="#2E3038" touchable="false"/>

        <!-- La lámpara y el haz. El haz es un prisma larguísimo: sin alfa ni
             volumétricos, la luz es un objeto sólido y flaco, y a esta escala
             alcanza. -->
        <group id="lampara" y="1.6">
          <sphere sx="1.1" sy="1.1" sz="1.1" color="#FFE9B0" touchable="false"/>
          <box z="90" sx="1.5" sy="0.9" sz="180" color="#FFD98A" touchable="false"/>
          <box z="-90" sx="1.5" sy="0.9" sz="180" color="#FFD98A" touchable="false"/>
        </group>
      </group>
    </group>

    <!-- El bote, allá abajo: la referencia de escala que se mira desde arriba. -->
    <group id="bote" x="24" y="-0.8" z="16" ry="0.6">
      <box sx="1.6" sy="0.7" sz="5.2" color="#3A3026" touchable="false" border-radius="0.5"/>
      <box y="0.5" sx="0.12" sy="4" sz="0.12" color="#5A4A36" touchable="false"/>
      <box y="1.8" x="0.5" sx="1.1" sy="2.2" sz="0.06" color="#C8C2B4" touchable="false"/>
    </group>

    <!-- El cartel, al pie de la escalera. -->
    <group x="0" y="0" z="5.8" ry="3.14159">
      <cylinder x="-1.2" y="0.7" sx="0.1" sy="1.4" sz="0.1" color="#2E3038" touchable="false"/>
      <cylinder x="1.2" y="0.7" sx="0.1" sy="1.4" sz="0.1" color="#2E3038" touchable="false"/>
      <box y="1.68" sx="2.7" sy="0.86" sz="0.06" color="#0E141E" touchable="false" border-radius="0.05"/>
      <text y="1.94" z="0.05" value="El faro" size="0.15" color="#EAF0F8"/>
      <text id="fa_dato" y="1.74" z="0.05" value="30 m · 96 escalones · 4.5 vueltas" size="0.07" color="#93A2B4"/>
      <box id="girar" y="1.5" z="0.05" sx="1.5" sy="0.22" sz="0.05" color="#A8443A" touchable="true" border-radius="0.04"/>
      <text id="fa_modo" y="1.505" z="0.09" value="parar el haz" size="0.07" color="#EAF0F8"/>
    </group>

    <group id="portal_vuelta" x="-6.5" y="0" z="5.4" ry="2.264">
        <!-- La misma puerta que las del atrio, y ahora entera de verdad: el vano
             es suyo y navega sola con hiperspace.world.navigate. Esta escena
             solo le delega navigate_world y le dice a donde lleva; el destino
             lo completa el servidor con el ?volver= que mando el atrio. -->
        <include id="puerta_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world"
                 props='{"destino":"https://njs58923.github.io/luna-demos/noche/index.hsml#entry=desde_faro","id":"atrio","titulo":"Al atrio","sub":"tocá para volver","roca":"#3A4450","color":"#1C2430"}'/>
      </group>

    <script>
      globalThis.FARO = {"base":"https://njs58923.github.io/luna-demos/noche","torre":{"radio":3.2,"alto":30,"vueltas":4.5,"escalones":96,"bandas":5}};
    </script>
    <script src="https://njs58923.github.io/luna-demos/noche/faro.js"/>
  </space>
</hsml>
