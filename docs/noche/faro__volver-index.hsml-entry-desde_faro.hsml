        <cylinder sx="7.36" sy="0.3" sz="7.36" color="#6E6A5E" touchable="false"/>
        <cylinder y="1.6" sx="5.44" sy="3.0" sz="5.44" color="#243040" touchable="false"/>
        <box x="0" y="1.6" z="2.72" ry="0" sx="0.12" sy="3.0" sz="0.12" color="#2E3038" touchable="false"/>
