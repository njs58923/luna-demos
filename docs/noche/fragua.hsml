      <box x="0" y="1.9" z="-0.62" ry="3.142" rx="-0.35" rz="0" sx="1.5" sy="1.3" sz="0.05" color="#4A2E1E" touchable="false"/>
      <box x="-0.62" y="1.9" z="0" ry="4.712" rx="0" rz="0.35" sx="1.5" sy="1.3" sz="0.05" color="#4A2E1E" touchable="false"/>
      <box y="2.9" sx="0.7" sy="0.9" sz="0.7" color="#3A2418" touchable="false"/>

      <!-- El fuelle. La tapa de arriba baja cuando se lo usa: es la unica pieza
           de la escena que se mueve por jerarquia y no por color. -->
      <group id="fuelle" x="-1.35" y="0.72" z="0" ry="1.5707963">
        <box y="-0.12" sx="1.1" sy="0.08" sz="0.7" color="#3A2A1C" touchable="false"/>
