<hsml>
  <head><name>La fragua</name></head>

  <!-- Separadas por COMA: parse_resource_tokens hace split(',') a secas. -->
  <space resources="navigate_self,navigate_world,read_camera_pose,vr_locomotion,desktop_camera_control,spawn">
    <!-- Donde aparece el visitante. A la derecha y en diagonal, mirando al conjunto yunque-hogar. Dos restricciones lo definen: no puede quedar detras del panel de la escena (z=3.1, ancho 3.7) porque lo taparia todo, y no puede estar muy cerca porque spawn no inclina el visor y el yunque esta un metro por debajo de los ojos. La regla para apuntar la mirada a un punto P desde S es ry = atan2(Sx-Px, Sz-Pz). -->
    <spawn id="entrada" default="true" x="3.00" y="0" z="2.60" ry="0.825"/>

    <group id="taller">
      <plane z="-40" y="4" sx="80" sy="18" color="#141210" touchable="false"/>
      <plane z="40" y="4" sx="80" sy="18" color="#141210" touchable="false"/>
      <plane x="-40" y="4" ry="1.5707963" sx="80" sy="18" color="#141210" touchable="false"/>
