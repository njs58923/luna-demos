      <plane y="40" rx="1.5707963" sx="80" sy="80" color="#05060A" touchable="false"/>
      <plane y="0" rx="1.5707963" sx="80" sy="80" color="#1A1814" touchable="false"/>
      <cylinder y="0.005" sx="14" sy="0.01" sz="14" color="#221E18" touchable="false"/>
    </group>

    <!-- El hogar: una caja de ladrillo con las brasas adentro y una campana
