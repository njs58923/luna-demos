    <!-- La nevada: una malla dinámica de 800 copos en UN nodo, que cae y
         se recicla. Ver public/invierno.js. -->
    <model id="nieve"/>

    <group x="0" y="3.618" z="52" ry="3.14159">
      <box y="2.1" sx="3.6" sy="0.66" sz="0.08" color="#232B33" touchable="false" border-radius="0.06"/>
      <cylinder x="-1.6" y="1.05" sx="0.12" sy="2.1" sz="0.12" color="#3A342C" touchable="false"/>
      <cylinder x="1.6" y="1.05" sx="0.12" sy="2.1" sz="0.12" color="#3A342C" touchable="false"/>
      <text y="2.24" z="0.06" value="El invierno" size="0.17" color="#EDF3F8"/>
      <text y="2.04" z="0.06" value="terreno de 128 m · 21 piezas talladas · 186161 caras" size="0.055" color="#B7C4CF"/>
      <text y="1.92" z="0.06" value="la opacidad venía en un PNG aparte, no en el canal alfa" size="0.05" color="#B7C4CF"/>
    </group>

    <group id="portal_vuelta" x="-6" y="3.618" z="50" ry="3.022">
        <!-- La misma puerta que las del atrio, y ahora entera de verdad: el vano
             es suyo y navega sola con hiperspace.world.navigate. Esta escena
             solo le delega navigate_world y le dice a donde lleva; el destino
             lo completa el servidor con el ?volver= que mando el atrio. -->
        <include id="puerta_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world"
                 props='{"destino":"https://njs58923.github.io/luna-demos/noche/index.hsml","id":"atrio","titulo":"Al atrio","sub":"tocá para volver","roca":"#4A5866","color":"#1C2430"}'/>
      </group>

    <script>
      globalThis.INVIERNO = {"base":"https://njs58923.github.io/luna-demos/noche","copos":800};
    </script>
    <script src="https://njs58923.github.io/luna-demos/noche/invierno.js"/>
  </space>
</hsml>
