    <group id="portal_vuelta" x="0" y="0" z="13.5">
        <!-- La misma puerta que las del atrio, y ahora entera de verdad: el vano
             es suyo y navega sola con hiperspace.world.navigate. Esta escena
             solo le delega navigate_world y le dice a donde lleva; el destino
             lo completa el servidor con el ?volver= que mando el atrio. -->
        <include id="puerta_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world"
                 props='{"destino":"https://njs58923.github.io/luna-demos/noche/index.hsml","id":"atrio","titulo":"Al atrio","sub":"tocá para volver","roca":"#3A3E40","color":"#1C2430"}'/>
      </group>

    <script>
      globalThis.JARDIN = {"base":"https://njs58923.github.io/luna-demos/noche","tope":420,"radio":9.5,"plantas":[{"nombre":"Helecho","detalle":"el clásico: una regla, tres ramas","axioma":"F","reglas":{"F":"F[+F]F[-F]F"},"giro":25.7,"pasos":3,"largo":0.5,"merma":0.62},{"nombre":"Arbusto","detalle":"la misma idea, con cabeceo","axioma":"F","reglas":{"F":"FF-[-F+F+F]+[+F-F-F]"},"giro":22.5,"pasos":3,"largo":0.72,"merma":0.68},{"nombre":"Árbol","detalle":"rola en cada bifurcación: crece en volumen","axioma":"F","reglas":{"F":"F[&+F]F[^-F]/F[&F]"},"giro":28,"pasos":3,"largo":0.62,"merma":0.7},{"nombre":"Sauce","detalle":"el mismo árbol con el giro al revés","axioma":"F","reglas":{"F":"F[&&+F][&&-F]F[&F]"},"giro":34,"pasos":3,"largo":0.66,"merma":0.72},{"nombre":"Alga","detalle":"dos símbolos que se reescriben entre sí","axioma":"A","reglas":{"A":"F[+A][-A]FA","F":"FF"},"giro":18,"pasos":4,"largo":0.34,"merma":0.86},{"nombre":"Cardo","detalle":"sin ramas hasta el final, y ahí todas juntas","axioma":"F","reglas":{"F":"FF[++F][--F][&F][^F]"},"giro":30,"pasos":3,"largo":0.8,"merma":0.6}],"colores":{"tallo":"#4E7A46","tallo2":"#6A9A52","hoja":"#8ECC6A","flor":"#E8C860"}};
    </script>
