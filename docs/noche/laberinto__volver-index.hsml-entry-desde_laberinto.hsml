<!-- generado por server_noche - no editar a mano -->
<hsml>
  <head><name>El laberinto</name></head>

  <!-- Separadas por COMA: parse_resource_tokens hace split(',') a secas.
       vr_locomotion importa más acá que en ninguna otra escena: ésta es la
       única que no se entiende sin caminarla. -->
  <space resources="navigate_self,navigate_world,read_camera_pose,vr_locomotion,desktop_camera_control,spawn,skybox">
    <include id="entorno" resources="skybox" src="https://njs58923.github.io/luna-demos/noche/componentes/cielo.hsml?preset=atardecer"/>
    <!-- Donde aparece el visitante. Esta es la unica escena que NO usa llegada():
         esa regla adelanta el marcador *hacia el centro de la sala*, y acá el
         centro de la sala es el medio del laberinto. Aparecerias adentro, en una
         celda cualquiera, sin haber entrado nunca por la boca.
         Va en la explanada, al costado del cartel y mirando a la entrada: el
         laberinto crece hacia +Z, y el forward de un spawn es (-sin ry, 0, -cos ry),
         asi que mirar a +Z es ry = PI; corrido 2,5 m para que el cartel no
         tape la boca, el giro sale de atan2(dx, dz) hacia la entrada. -->
    <spawn id="entrada" default="true" x="-21.5" y="0" z="-32.1" ry="2.774"/>
    <group id="cielo">
    </group>

