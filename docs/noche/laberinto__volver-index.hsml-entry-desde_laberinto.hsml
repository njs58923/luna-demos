    </group>

    <!-- El cartel de la entrada, con el contador de faroles. -->
    <!-- ry=π: el texto es de una cara y mira a +Z local. Sin girar, le daba la
         cara al laberinto y el que llegaba leía el dorso. -->
    <group x="-24" y="0" z="-28" ry="3.14159">
      <cylinder x="-1.3" y="0.75" sx="0.1" sy="1.5" sz="0.1" color="#1C1A16" touchable="false"/>
      <cylinder x="1.3" y="0.75" sx="0.1" sy="1.5" sz="0.1" color="#1C1A16" touchable="false"/>
      <box y="1.86" sx="2.9" sy="0.86" sz="0.06" color="#0F131A" touchable="false" border-radius="0.05"/>
      <text y="2.12" z="0.05" value="El laberinto" size="0.15" color="#E8EEF6"/>
      <text id="l_estado" y="1.92" z="0.05" value="16×16 · 24 faroles apagados" size="0.07" color="#93A2B4"/>
      <text y="1.78" z="0.05" value="tocá un farol al pasar: es la única forma de saber dónde estuviste" size="0.05" color="#93A2B4"/>
      <text id="l_semilla" y="1.66" z="0.05" value="semilla 12345" size="0.05" color="#93A2B4"/>
    </group>

    <group id="portal_vuelta" x="-28.5" y="0" z="-28" ry="0">
        <!-- La misma puerta que las del atrio, y ahora entera de verdad: el vano
             es suyo y navega sola con hiperspace.world.navigate. Esta escena
             solo le delega navigate_world y le dice a donde lleva; el destino
             lo completa el servidor con el ?volver= que mando el atrio. -->
        <include id="puerta_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world"
                 props='{"destino":"https://njs58923.github.io/luna-demos/noche/index.hsml#entry=desde_laberinto","id":"atrio","titulo":"Al atrio","sub":"tocá para volver","roca":"#4A4638","color":"#1C2430"}'/>
      </group>

