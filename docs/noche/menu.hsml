<?xml version="1.0" encoding="UTF-8"?>
<!-- generado por server_noche - no editar a mano -->
<hsml>
  <head><name>Maqueta del menu VR</name></head>

  <space resources="read_camera_pose,spawn,vr_locomotion,desktop_camera_control">
    <!-- El visitante mira a -Z desde el origen, que es donde el shell asume que
         esta la cabeza. El forward de un spawn es (-sin ry, 0, -cos ry): con
         ry=0 se mira a -Z, que es hacia el panel. -->
    <spawn id="entrada" default="true" x="0" y="0" z="0" ry="0"/>

    <group id="cielo">
      <plane z="-40" sx="80" sy="80" color="#0C0E13" touchable="false"/>
      <plane z="40" sx="80" sy="80" color="#0C0E13" touchable="false"/>
      <plane x="-40" ry="1.5707963" sx="80" sy="80" color="#0C0E13" touchable="false"/>
      <plane x="40" ry="1.5707963" sx="80" sy="80" color="#0C0E13" touchable="false"/>
      <plane y="40" rx="1.5707963" sx="80" sy="80" color="#0C0E13" touchable="false"/>
    </group>

    <cylinder y="-0.05" sx="16" sy="0.1" sz="16" color="#191C23" touchable="false"/>
    <cylinder y="0.002" sx="7" sy="0.01" sz="7" color="#20242D" touchable="false"/>
    <box x="-3.6" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="-5.6" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="-3" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="-5" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
