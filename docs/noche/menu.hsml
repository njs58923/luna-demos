    <box y="0.005" z="-4.4" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="-1.8" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="-3.8" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="-1.2" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="-3.2" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="-0.6" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="-2.6" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="0" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="-2" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="0.6" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="-1.4" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="1.2" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="-0.8" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="1.8" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="-0.2" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="2.4" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="0.4" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="3" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="1" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>
    <box x="3.6" y="0.005" z="-2" sx="0.012" sy="0.01" sz="6" color="#2A2F3A" touchable="false"/>
    <box y="0.005" z="1.6" sx="7.2" sy="0.01" sz="0.012" color="#2A2F3A" touchable="false"/>

    <!-- Los cuatro contenedores. Todo lo de adentro lo crea el script con
         createElement, porque la cuenta del arco tiene que estar escrita una
         sola vez y en un solo lugar: es lo que hay que portar al motor. -->
    <group id="fijados"/>
    <group id="panel"/>
    <group id="barra"/>
    <group id="controles"/>

    <!-- Los fondos de las pastillas, en UNA malla.
         Un <plane> es plano y las piezas van sobre un cilindro: en el panel la
         flecha del arco llega a 12 cm sobre 1,27 m de ancho, asi que la placa se
         queda atras justo donde los iconos se adelantan, y en la barra el plano
         de la placa llegaba a cortar al item del extremo. Una malla que sigue el
         arco no tiene ese problema y ademas deja acercar los iconos: quedan a 8
         mm de su fondo, iguales de punta a punta. -->
    <model id="fondos"/>

