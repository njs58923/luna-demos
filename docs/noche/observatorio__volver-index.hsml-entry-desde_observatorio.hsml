    <!-- ---------------------------------------------------------------- -->
    <!-- El telescopio. Cuatro grupos anidados, y el orden es el que importa: -->
    <!--                                                                    -->
    <!--   pilar        fijo                                                -->
    <!--   +- polar     inclinado la latitud: el eje apunta a la Polar      -->
    <!--      +- hora   gira alrededor de ese eje (un motor, y alcanza)     -->
    <!--         +- dec gira perpendicular: elige la altura sobre el ecuador -->
    <!--            +- tubo y contrapeso                                     -->
    <!--                                                                    -->
    <!-- Cada grupo hereda al anterior, así que el script sólo escribe dos    -->
    <!-- ángulos: hora y dec. Toda la geometría de la montura está en la  -->
    <!-- jerarquía, no en el código.                                          -->
    <group id="pilar" x="0" y="0" z="0">
      <cylinder y="0.28" sx="2.4" sy="0.56" sz="2.4" color="#3E4552" touchable="false"/>
      <!-- La columna tiene que ser mas alta que la mitad del tubo o el tubo
           raspa el piso al bajar de declinacion. En un observatorio de verdad la
           altura del pilar la manda exactamente esto. -->
      <cylinder y="1.65" sx="0.9" sy="2.3" sz="0.9" color="#6A7280" touchable="false"/>
      <cylinder y="2.88" sx="1.2" sy="0.22" sz="1.2" color="#C8A24E" touchable="false"/>

      <group id="polar" y="3.0" rx="0.855">
        <!-- El eje polar, dibujado: es la pieza que explica la montura. -->
        <cylinder sx="0.42" sy="1.5" sz="0.42" color="#6A7280" touchable="false"/>

        <group id="hora" y="0.85">
          <cylinder y="0.1" sx="0.9" sy="0.16" sz="0.9" color="#C8A24E" touchable="false"/>
          <cylinder y="0.35" rz="1.5707963" sx="0.34" sy="1.7" sz="0.34" color="#6A7280" touchable="false"/>

          <group id="dec" y="0.35">
            <!-- El tubo: dos cilindros y una boca. Va corrido en X para que el
                 contrapeso del otro lado tenga sentido. -->
            <group id="tubo" x="0.95">
              <cylinder rx="1.5707963" sx="0.62" sy="3.4" sz="0.62" color="#8A9099" touchable="false"/>
              <cylinder z="1.72" rx="1.5707963" sx="0.72" sy="0.16" sz="0.72" color="#C8A24E" touchable="false"/>
              <cylinder z="-1.66" rx="1.5707963" sx="0.68" sy="0.3" sz="0.68" color="#4A5058" touchable="false"/>
              <!-- El buscador, arriba del tubo. Es la pieza que hace que se lea
                   como un telescopio y no como un caño. -->
              <cylinder y="0.42" z="0.9" rx="1.5707963" sx="0.18" sy="0.9" sz="0.18" color="#3E4552" touchable="false"/>
              <box y="0.3" z="1.1" sx="0.06" sy="0.2" sz="0.06" color="#3E4552" touchable="false"/>
              <box y="0.3" z="0.7" sx="0.06" sy="0.2" sz="0.06" color="#3E4552" touchable="false"/>
              <!-- El ocular, atrás y abajo. -->
              <cylinder y="-0.34" z="-1.5" sx="0.16" sy="0.5" sz="0.16" color="#C8A24E" touchable="false"/>
            </group>
            <!-- El contrapeso: la barra y dos discos. En una montura de verdad
                 es lo que permite que un motor chico mueva el tubo. -->
            <group id="lastre" x="-1.15">
              <cylinder rz="1.5707963" sx="0.14" sy="1.5" sz="0.14" color="#3E4552" touchable="false"/>
              <cylinder x="-0.5" rz="1.5707963" sx="0.75" sy="0.22" sz="0.75" color="#2A2C30" touchable="false"/>
              <cylinder x="-0.78" rz="1.5707963" sx="0.75" sy="0.22" sz="0.75" color="#2A2C30" touchable="false"/>
            </group>
          </group>
        </group>
      </group>
    </group>

    <group id="tablero" x="0" y="0" z="8.6" ry="3.14159">
      <cylinder x="-1.7" y="0.75" sx="0.12" sy="1.5" sz="0.12" color="#3E4552" touchable="false"/>
      <cylinder x="1.7" y="0.75" sx="0.12" sy="1.5" sz="0.12" color="#3E4552" touchable="false"/>
      <box y="1.66" rx="-0.35" sx="3.8" sy="1.15" sz="0.07" color="#0E1218" touchable="false" border-radius="0.05"/>
