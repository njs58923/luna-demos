    <!-- El sol: un disco lejano que el script mueve. No ilumina nada, es un
         cartel que dice de dónde viene la luz que el script está calculando. -->
    <group id="sol" x="0" y="40" z="0">
      <cylinder rx="1.5707963" sx="4.0" sy="0.1" sz="4.0" color="#FFE8B0" touchable="false"/>
    </group>

