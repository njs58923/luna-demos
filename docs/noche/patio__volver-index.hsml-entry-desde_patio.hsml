  <head><name>El patio</name></head>

  <!-- Separadas por COMA: parse_resource_tokens hace split(',') a secas. -->
  <space resources="navigate_self,navigate_world,read_camera_pose,vr_locomotion,desktop_camera_control,spawn">
    <!-- Donde aparece el visitante. Va en el **hueco entre dos columnas**, no en
         el eje: con la columnata en anillo, el eje siempre tiene una columna
         enfrente y lo primero que se ve es un poste a dos metros. Medio paso de
         separacion angular resuelve el encuadre entero.

         Ojo con el ry, que costo dos corridas medirlo: el spawn mira hacia
         **-Z** y su forward es (-sin ry, 0, -cos ry). Para mirar al origen desde
         (x, z) va **atan2(x, z)** — que aca, por estar el punto sobre el radio,
         se simplifica al angulo mismo. NO es el atan2(-x, -z) que usan los arcos
         y los paneles de todo el servidor: eso orienta un objeto cuyo
         **contenido** mira a su +Z local, y da justo lo contrario. -->
    <spawn id="entrada" default="true" x="1.384" y="0" z="10.509" ry="0.131"/>

    <group id="cielo">
      <group ry="0">
        <plane z="-90" y="30" sx="198.00000000000003" sy="70" color="#1E2A3E" touchable="false"/>
