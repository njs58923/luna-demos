<!-- generado por server_noche - no editar a mano -->
<hsml>
  <head><name>La pradera</name></head>

  <!-- Separadas por COMA: parse_resource_tokens hace split(',') a secas. -->
  <space resources="navigate_self,navigate_world,read_camera_pose,vr_locomotion,desktop_camera_control,spawn">
    <!-- Donde aparece el visitante: delante del portal, de espaldas al arco y mirando al centro. Ver llegada() en escena.ts. -->
    <spawn id="entrada" default="true" x="-4.978" y="0" z="6.892" ry="-0.625"/>
    <group id="cielo">
      <plane z="-900" sx="1800" sy="1800" color="#8FB4D8" touchable="false"/>
      <plane z="900" sx="1800" sy="1800" color="#8FB4D8" touchable="false"/>
      <plane x="-900" ry="1.5707963" sx="1800" sy="1800" color="#8FB4D8" touchable="false"/>
      <plane x="900" ry="1.5707963" sx="1800" sy="1800" color="#8FB4D8" touchable="false"/>
      <plane y="900" rx="1.5707963" sx="1800" sy="1800" color="#8FB4D8" touchable="false"/>
      <!-- Acá iba una banda cálida de horizonte, un cilindro enorme alrededor
           de todo. No sirve: **un cilindro visto desde adentro no se dibuja**,
           las caras miran para afuera. Lo único que se puede encarar hacia
           adentro sin trabajo es un plane, que sí es de doble cara. El
           amanecer queda entonces en el halo del sol y en el tono del cielo. -->
      <!-- El sol, bajo y grande. Dos esferas, como la luna del bestiario. -->
      <sphere x="-260" y="46" z="-738" sx="230" sy="230" sz="230" color="#FFCE93" touchable="false"/>
      <sphere x="-260" y="46" z="-738" sx="120" sy="120" sz="120" color="#FFF4CE" touchable="false"/>
    </group>

    <!-- Las nubes: tres capas, un nodo cada una, malla dinámica. La animación
         mueve el nodo y no las nubes. Ver public/pradera.js. -->
    <model id="nubes_0"/>
    <model id="nubes_1"/>
    <model id="nubes_2"/>

    <group id="terreno">
      <!-- Disco de respaldo. Aunque las losas se solapen, alguna junta queda, y
