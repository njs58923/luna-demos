    <!-- El panel, abajo a la derecha. El botón cambia entre la hora de la
         máquina y el cronómetro desde que se abrió la escena. -->
    <group id="panel" x="7.6" y="0" z="2.4" ry="-0.7">
      <cylinder x="-1.2" y="0.65" sx="0.1" sy="1.3" sz="0.1" color="#4A3A20" touchable="false"/>
      <cylinder x="1.2" y="0.65" sx="0.1" sy="1.3" sz="0.1" color="#4A3A20" touchable="false"/>
      <box y="1.6" sx="2.7" sy="0.92" sz="0.06" color="#0E1218" touchable="false" border-radius="0.06"/>
      <text id="r_titulo" y="1.88" z="0.05" value="El reloj" size="0.15" color="#EFE6D2"/>
      <text id="r_hora" y="1.68" z="0.05" value="--:--:--" size="0.12" color="#A99A7E"/>
      <box id="modo" y="1.4" z="0.05" sx="1.6" sy="0.24" sz="0.05" color="#8A6A2E" touchable="true" border-radius="0.04"/>
      <text id="r_modo" y="1.405" z="0.09" value="ver cronómetro" size="0.075" color="#EFE6D2"/>
    </group>

    <group id="portal_vuelta" x="-7.6" y="0" z="2.4" ry="0.7">
        <!-- La misma puerta que las del atrio, y ahora entera de verdad: el vano
             es suyo y navega sola con hiperspace.world.navigate. Esta escena
             solo le delega navigate_world y le dice a donde lleva; el destino
             lo completa el servidor con el ?volver= que mando el atrio. -->
        <include id="puerta_atrio" src="https://njs58923.github.io/luna-demos/noche/puerta.hsml" resources="navigate_world"
                 props='{"destino":"https://njs58923.github.io/luna-demos/noche/index.hsml#entry=desde_reloj","id":"atrio","titulo":"Al atrio","sub":"tocá para volver","roca":"#4A4432","color":"#1C2430"}'/>
      </group>

    <script>
      globalThis.RELOJ = {"base":"https://njs58923.github.io/luna-demos/noche"};
    </script>
    <script src="https://njs58923.github.io/luna-demos/noche/reloj.js"/>
  </space>
</hsml>
