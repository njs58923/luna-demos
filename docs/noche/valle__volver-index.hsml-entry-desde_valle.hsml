      <plane y="-3400" rx="1.5707963" sx="6800" sy="6800" color="#0A0E1A" touchable="false"/>
      <!-- Luna **detrás** de la cordillera, a 2,8 km. Puesta más cerca que las
           montañas no había escala: parecía una lámpara colgada del decorado.
           Recortada por los picos, el ojo deduce el tamaño del paisaje. -->
      <sphere x="-780" y="700" z="-3200" sx="640" sy="640" sz="640" color="#3A4258" touchable="false"/>
      <sphere x="-780" y="700" z="-3200" sx="330" sy="330" sz="330" color="#E8ECD8" touchable="false"/>
    </group>

    <!-- Los cuatro anillos del terreno, las montañas y las tres capas de nubes.
         Todos vacíos: los llena public/valle.js con mallas dinámicas. El LOD es
         eso — un nodo por anillo, con el paso creciendo hacia afuera. -->
