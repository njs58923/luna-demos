<hsml>
  <head><name>Valle nocturno</name></head>

  <space resources="navigate_self,navigate_world,read_camera_pose,vr_locomotion,desktop_camera_control,spawn">
    <!-- Donde aparece el visitante: delante del portal, de espaldas al arco y mirando al centro. Ver llegada() en escena.ts. -->
    <spawn id="entrada" default="true" x="0" y="0" z="1.6" ry="0"/>
    <group id="cielo">
      <plane z="-3400" sx="6800" sy="6800" color="#0A0E1A" touchable="false"/>
      <plane z="3400" sx="6800" sy="6800" color="#0A0E1A" touchable="false"/>
      <plane x="-3400" ry="1.5707963" sx="6800" sy="6800" color="#0A0E1A" touchable="false"/>
