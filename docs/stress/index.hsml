<?xml version="1.0" encoding="UTF-8"?>
<!-- Luna Stress: el banco de pruebas de carga. Documento estático: la
     carga la arma stress.js en vivo dentro de #carga, y los parámetros se
     cambian por query (?auto=todo, ?tolerancia=5, ...; ver stress.js). -->
<hsml>
  <head><name>Luna Stress</name></head>

  <!-- Sin capacidades de posición salvo spawn: ningún test depende de dónde
       esté el visitante, pero *empezar siempre en el mismo lado* saca una
       variable de la medición en vez de meterla — dos corridas con el visitante
       a distinta distancia del panel no dibujan lo mismo.
       Separadas por COMA: parse_resource_tokens hace split(',') a secas y con
       espacios queda un token que no matchea nada, en silencio. -->
  <space resources="navigate_self,spawn">
    <!-- Donde aparece el visitante: el origen, que es donde el panel ya daba por
         sentado que estaba (PANEL.z = -2.5 se eligio "adelante del spawn, no
         encima"). El marcador no lo mueve: lo fija, para que dos corridas midan
         desde el mismo lugar. -->
    <spawn id="entrada" default="true" x="0" y="0" z="0" ry="0"/>
    <group id="cielo">
      <plane z="-500" sx="1000" sy="1000" color="#B7CCD2" touchable="false"/>
      <plane z="500" sx="1000" sy="1000" color="#B7CCD2" touchable="false"/>
      <plane x="-500" ry="1.5707963" sx="1000" sy="1000" color="#B7CCD2" touchable="false"/>
      <plane x="500" ry="1.5707963" sx="1000" sy="1000" color="#B7CCD2" touchable="false"/>
      <plane y="500" rx="1.5707963" sx="1000" sy="1000" color="#B7CCD2" touchable="false"/>
      <plane y="-500" rx="1.5707963" sx="1000" sy="1000" color="#B7CCD2" touchable="false"/>
      <sphere x="-32" y="27" z="-80" sx="9" sy="9" sz="9" color="#FFF0CF" touchable="false"/>
    </group>

    <group id="isla">
      <cylinder y="-0.18" sx="20" sy="0.36" sz="18" color="#82947A" touchable="false"/>
      <cylinder y="-0.60" sx="19.7" sy="0.50" sz="17.7" color="#6C7566" touchable="false"/>
      <cylinder x="0.2" y="-1.2" sx="17.8" sy="0.75" sz="15.9" color="#59635D" touchable="false"/>
      <cylinder x="0.5" y="-1.95" sx="14.8" sy="0.80" sz="13.2" color="#485550" touchable="false"/>
      <cylinder x="0.8" y="-2.7" sx="10.4" sy="0.80" sz="9.4" color="#3E4B48" touchable="false"/>
      <cylinder x="1.0" y="-3.35" sx="5.8" sy="0.60" sz="5.2" color="#35433F" touchable="false"/>

      <box x="-5.6" y="0.34" z="-2.8" ry="0.4" rz="0.12" sx="1.35" sy="0.85" sz="1.1" color="#ADB3A1" touchable="false"/>
      <box x="-4.6" y="0.16" z="-2.5" ry="-0.3" sx="0.65" sy="0.40" sz="0.7" color="#949E8C" touchable="false"/>
      <box x="5.8" y="0.24" z="1.4" ry="0.7" rz="-0.15" sx="1.1" sy="0.65" sz="0.9" color="#A2AB99" touchable="false"/>

      <group x="-3.8" z="-4.8">
        <plane x="-0.08" y="0.16" rz="0.25" sx="0.07" sy="0.34" color="#556D49" touchable="false"/>
        <plane y="0.22" ry="0.6" sx="0.08" sy="0.44" color="#647D50" touchable="false"/>
        <plane x="0.1" y="0.14" rz="-0.35" sx="0.07" sy="0.30" color="#718857" touchable="false"/>
      </group>
      <group x="4.6" z="-3.5" ry="1.0">
        <plane x="-0.08" y="0.16" rz="0.25" sx="0.07" sy="0.34" color="#556D49" touchable="false"/>
        <plane y="0.22" ry="0.6" sx="0.08" sy="0.44" color="#647D50" touchable="false"/>
        <plane x="0.1" y="0.14" rz="-0.35" sx="0.07" sy="0.30" color="#718857" touchable="false"/>
      </group>
    </group>

    <group id="panel">
      <cylinder x="-1.150" y="1.400" z="-2.585" sx="0.090" sy="2.800" sz="0.090" color="#6E6257" touchable="false"/>
      <cylinder x="-1.150" y="0.05" z="-2.585" sx="0.171" sy="0.1" sz="0.171" color="#4F4A44" touchable="false"/>
      <cylinder x="1.150" y="1.400" z="-2.585" sx="0.090" sy="2.800" sz="0.090" color="#6E6257" touchable="false"/>
      <cylinder x="1.150" y="0.05" z="-2.585" sx="0.171" sy="0.1" sz="0.171" color="#4F4A44" touchable="false"/>
      <box x="0.000" y="1.400" z="-2.500" sx="3.200" sy="2.520" sz="0.070" color="#EDF1F3" touchable="false"/>
      <box x="0.000" y="1.400" z="-2.500" sx="3.400" sy="2.320" sz="0.070" color="#EDF1F3" touchable="false"/>
      <cylinder x="-1.600" y="0.240" z="-2.500" rx="1.5707963" sx="0.200" sy="0.070" sz="0.200" color="#EDF1F3" touchable="false"/>
      <cylinder x="-1.600" y="2.560" z="-2.500" rx="1.5707963" sx="0.200" sy="0.070" sz="0.200" color="#EDF1F3" touchable="false"/>
      <cylinder x="1.600" y="0.240" z="-2.500" rx="1.5707963" sx="0.200" sy="0.070" sz="0.200" color="#EDF1F3" touchable="false"/>
      <cylinder x="1.600" y="2.560" z="-2.500" rx="1.5707963" sx="0.200" sy="0.070" sz="0.200" color="#EDF1F3" touchable="false"/>
      <text y="2.420" z="-2.435" value="Luna Stress" size="0.13" color="#1E2C36"/>
      <box y="2.330" z="-2.445" sx="3.100" sy="0.01" sz="0.01" color="#C4D0D6" touchable="false"/>

      <box y="2.160" z="-2.450" sx="3.100" sy="0.180" sz="0.01" color="#DFE6EA" touchable="false"/>
      <box id="btn_figuras" x="-1.420" y="2.160" z="-2.425" sx="0.220" sy="0.140" sz="0.050" color="#37576B" touchable="true"/>
